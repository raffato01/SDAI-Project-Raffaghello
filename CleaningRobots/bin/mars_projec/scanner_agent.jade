module mars_project

agent ScannerAgent uses ontology MarsOntology

    property myX as integer = 0
    property myY as integer = 0

    property r2X as integer = 3
    property r2Y as integer = 3

    property lastX as integer = 0
    property lastY as integer = 0

    on create do
        log "r1 (ScannerAgent) started [Modular Behaviours]. Scanning rows 0-3."
        activate ScanGrid

cyclic behavior ScanGrid
    for agent ScannerAgent
    uses ontology mars_project.MarsOntology

    property waitingPercepts as boolean = false

    on activate do
        waitingPercepts = false

    on execute do
        if not waitingPercepts do
            waitingPercepts = true
            send message request DoNextSlot to "environment"@

    on message inform Percepts(x, y, rx, ry, hasGarb) do
        waitingPercepts = false
        myX of agent = x
        myY of agent = y
        r2X of agent = rx
        r2Y of agent = ry

        if (myY of agent) >= 4 do
            log "r1: Scan finished."
            deactivate this
        else if hasGarb do
            log "r1: Garbage found at (" + (myX of agent) as text + "," + (myY of agent) as text + ")"
            lastX of agent = myX of agent
            lastY of agent = myY of agent
            deactivate this
            activate PickGarbage

cyclic behavior PickGarbage
    for agent ScannerAgent
    uses ontology mars_project.MarsOntology

    on activate do
        log "r1: Attempting to pick garbage..."
        send message request DoPick to "environment"@

    on message inform PickedSuccessfully do
        log "r1: Garbage picked up! Heading to r2..."
        deactivate this
        activate DeliverToR2

    on message inform PickFailed do
        log "r1: Pick failed, retrying..."
        send message request DoPick to "environment"@

cyclic behavior DeliverToR2
    for agent ScannerAgent
    uses ontology mars_project.MarsOntology

    property waitingPercepts as boolean = false
    property waitingDrop as boolean = false

    on activate do
        waitingPercepts = false
        waitingDrop = false

    on execute do
        if not waitingPercepts and not waitingDrop do
            if ((myX of agent) = (r2X of agent) and (myY of agent) = (r2Y of agent)) do
                waitingDrop = true
                send message request DoDrop to "environment"@
            else do
                waitingPercepts = true
                send message request DoMoveTowards(r2X of agent, r2Y of agent) to "environment"@

    on message inform Percepts(x, y, rx, ry, hasGarb) do
        waitingPercepts = false
        myX of agent = x
        myY of agent = y

    on message inform ActionCompleted do
        if waitingDrop do
            log "r1: Garbage delivered to r2. Returning to last position..."
            waitingDrop = false
            deactivate this
            activate ReturnToLast

cyclic behavior ReturnToLast
    for agent ScannerAgent
    uses ontology mars_project.MarsOntology

    property waitingPercepts as boolean = false

    on activate do
        waitingPercepts = false

    on execute do
        if not waitingPercepts do
            if ((myX of agent) = (lastX of agent) and (myY of agent) = (lastY of agent)) do
                log "r1: Returned to (" + (lastX of agent) as text + "," + (lastY of agent) as text + "). Resuming scan."
                deactivate this
                activate ScanGrid
            else do
                waitingPercepts = true
                send message request DoMoveTowards(lastX of agent, lastY of agent) to "environment"@

    on message inform Percepts(x, y, rx, ry, hasGarb) do
        waitingPercepts = false
        myX of agent = x
        myY of agent = y
